theorem check_all : ∀ s < 1024, checkOne s (dat s) = true := by
  intro s hs
  obtain ⟨q, t, hq, ht, rfl⟩ : ∃ q t, q < 32 ∧ t < 32 ∧ s = 32 * q + t :=
    ⟨s / 32, s % 32, by omega, Nat.mod_lt _ (by norm_num), by omega⟩
  have e1 : (32 * q + t) / 32 = q := by omega
  have e2 : (32 * q + t) % 32 = t := by omega
  unfold dat
  rw [e1, e2]
  interval_cases q
  · exact c0 t ht
  · exact c1 t ht
  · exact c2 t ht
  · exact c3 t ht
