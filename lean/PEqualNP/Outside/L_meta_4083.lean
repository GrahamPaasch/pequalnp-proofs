open PEqualNP.CircuitLowerBounds

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem wires_eq (C : Circuit) (x : List Bool) : C.wires x = C.gates.foldl step x := rfl

theorem foldl_prefix (L : List Gate) (x : List Bool) : ∃ ys, L.foldl step x = x ++ ys := by
  induction L generalizing x with
  | nil => exact ⟨[], by simp⟩
  | cons g L ih =>
    obtain ⟨ys, hys⟩ := ih (step x g)
    refine ⟨[g.op.eval (g.inputs.map fun i => x.getD i false)] ++ ys, ?_⟩
    rw [List.foldl_cons, hys, step, List.append_assoc]

theorem foldl_length (L : List Gate) (x : List Bool) :
    (L.foldl step x).length = x.length + L.length := by
  induction L generalizing x with
  | nil => simp
  | cons g L ih => rw [List.foldl_cons, ih]; simp [step]; omega

theorem getD_append_lt (P Q : List Bool) (u : ℕ) (hu : u < P.length) :
    (P ++ Q).getD u false = P.getD u false := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hu]

theorem getD_ge (P : List Bool) (u : ℕ) (hu : P.length ≤ u) : P.getD u false = false := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hu]

theorem wires_lt (C : Circuit) (x : List Bool) (w : ℕ) (hw : w < x.length) :
    (C.wires x).getD w false = x.getD w false := by
  obtain ⟨ys, hys⟩ := foldl_prefix C.gates x
  rw [wires_eq, hys, getD_append_lt _ _ _ hw]

theorem wires_length (C : Circuit) (x : List Bool) :
    (C.wires x).length = x.length + C.gates.length := by
  rw [wires_eq, foldl_length]

theorem wires_ge (C : Circuit) (x : List Bool) (w : ℕ) (hw : x.length + C.gates.length ≤ w) :
    (C.wires x).getD w false = false :=
  getD_ge _ _ (by rw [wires_length]; exact hw)

theorem wires_gate (C : Circuit) (x : List Bool) (i : ℕ) (hi : i < C.gates.length) :
    (C.wires x).getD (x.length + i) false =
      C.gates[i].op.eval (C.gates[i].inputs.map fun u =>
        if u < x.length + i then (C.wires x).getD u false else false) := by
  obtain ⟨g, hg⟩ : ∃ g, C.gates[i] = g := ⟨_, rfl⟩
  rw [hg]
  have hsplit : C.gates = C.gates.take i ++ (g :: C.gates.drop (i + 1)) := by
    rw [← hg, ← List.drop_eq_getElem_cons hi, List.take_append_drop]
  set P := (C.gates.take i).foldl step x with hP
  have hPl : P.length = x.length + i := by
    rw [hP, foldl_length, List.length_take]; omega
  obtain ⟨ys, hys⟩ := foldl_prefix (C.gates.drop (i + 1)) (step P g)
  have hfull : C.wires x = P ++ ([g.op.eval (g.inputs.map fun u => P.getD u false)] ++ ys) := by
    have h1 : C.wires x = (C.gates.take i ++ (g :: C.gates.drop (i + 1))).foldl step x := by
      rw [wires_eq]; exact congrArg (fun L => L.foldl step x) hsplit
    rw [h1, List.foldl_append, ← hP, List.foldl_cons, hys, step, List.append_assoc]
  have key : ∀ u, P.getD u false = if u < x.length + i then (C.wires x).getD u false else false := by
    intro u
    split_ifs with hu
    · rw [hfull, getD_append_lt _ _ _ (by omega)]
    · exact getD_ge _ _ (by omega)
  have hv : (C.wires x).getD (x.length + i) false = g.op.eval (g.inputs.map fun u => P.getD u false) := by
    rw [hfull, ← hPl]
    simp [List.getD_eq_getElem?_getD]
  rw [hv]
  congr 1
  exact List.map_congr_left (fun u _ => key u)


theorem agree (C : Circuit) (x y : List Bool) (hx : x.length = 11) (hy : y.length = 11)
    (P : ℕ → Prop)
    (hbase : ∀ w < 11, P w → x.getD w false = y.getD w false)
    (hgate : ∀ i (hi : i < C.gates.length), P (11 + i) → ∀ u ∈ C.gates[i].inputs,
      P u ∨ (C.wires x).getD u false = (C.wires y).getD u false) :
    ∀ w, P w → (C.wires x).getD w false = (C.wires y).getD w false := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w ih =>
    intro hw
    by_cases h11 : w < 11
    · rw [wires_lt C x w (by omega), wires_lt C y w (by omega)]
      exact hbase w h11 hw
    · by_cases hg : w < 11 + C.gates.length
      · obtain ⟨i, rfl⟩ : ∃ i, w = 11 + i := ⟨w - 11, by omega⟩
        have hi : i < C.gates.length := by omega
        have ex := wires_gate C x i hi
        have ey := wires_gate C y i hi
        rw [hx] at ex; rw [hy] at ey
        rw [ex, ey]
        congr 1
        apply List.map_congr_left
        intro u hu
        split_ifs with hlt
        · rcases hgate i hi hw u hu with h | h
          · exact ih u hlt h
          · exact h
        · rfl
      · rw [wires_ge C x w (by omega), wires_ge C y w (by omega)]

def xs (z : Fin 10 → Bool) : List Bool := List.ofFn z ++ [!z 0]

theorem xs_length (z : Fin 10 → Bool) : (xs z).length = 11 := by simp [xs]

theorem xs_lt (z : Fin 10 → Bool) (w : ℕ) (hw : w < 10) : (xs z).getD w false = z ⟨w, hw⟩ := by
  interval_cases w <;> simp [xs]

theorem xs_ten (z : Fin 10 → Bool) : (xs z).getD 10 false = !z 0 := by
  simp [xs, List.getD_eq_getElem?_getD]

-- the locality argument
theorem key (C : Circuit) (S : Finset (Fin 10)) (K B : Finset ℕ)
    (hK1 : ∀ i : Fin 10, (i : ℕ) ∈ K ↔ i ∈ S) (hK2 : (10 : ℕ) ∈ K ↔ (0 : Fin 10) ∈ S)
    (hcl : ∀ (j : Fin C.size), ∀ u ∈ (C.gates.get j).inputs,
      ((11 : ℕ) + ↑j ∈ K → u ∈ K) ∧ ((11 : ℕ) + ↑j ∉ K → u ∈ K → u ∈ B))
    (hout : C.output ∈ K → C.output ∈ B)
    (z1 z2 u1 u2 : Fin 10 → Bool)
    (hB : ∀ w ∈ B, (C.wires (xs z1)).getD w false = (C.wires (xs z2)).getD w false)
    (h1 : ∀ i ∈ S, u1 i = z1 i) (h2 : ∀ i ∈ S, u2 i = z2 i) (h12 : ∀ i ∉ S, u1 i = u2 i) :
    C.eval (xs u1) = C.eval (xs u2) := by
  have hcl' : ∀ i (hi : i < C.gates.length), ∀ u ∈ C.gates[i].inputs,
      ((11 : ℕ) + i ∈ K → u ∈ K) ∧ ((11 : ℕ) + i ∉ K → u ∈ K → u ∈ B) := by
    intro i hi u hu
    exact hcl ⟨i, hi⟩ u hu
  have inK : ∀ (a b : Fin 10 → Bool), (∀ i ∈ S, a i = b i) →
      ∀ w, w ∈ K → (C.wires (xs a)).getD w false = (C.wires (xs b)).getD w false := by
    intro a b hab
    apply agree C _ _ (xs_length a) (xs_length b) (· ∈ K)
    · intro w hw hwK
      by_cases h10 : w < 10
      · rw [xs_lt a w h10, xs_lt b w h10]
        exact hab _ ((hK1 ⟨w, h10⟩).1 hwK)
      · obtain rfl : w = 10 := by omega
        rw [xs_ten, xs_ten, hab 0 (hK2.1 hwK)]
    · intro i hi hK u hu
      exact Or.inl ((hcl' i hi u hu).1 hK)
  have hBK : ∀ w ∈ B, w ∈ K → (C.wires (xs u1)).getD w false = (C.wires (xs u2)).getD w false := by
    intro w hwB hwK
    rw [inK u1 z1 h1 w hwK, hB w hwB, inK u2 z2 h2 w hwK]
  have outK : ∀ w, w ∉ K → (C.wires (xs u1)).getD w false = (C.wires (xs u2)).getD w false := by
    apply agree C _ _ (xs_length u1) (xs_length u2) (· ∉ K)
    · intro w hw hwK
      by_cases h10 : w < 10
      · rw [xs_lt u1 w h10, xs_lt u2 w h10]
        exact h12 _ (fun h => hwK ((hK1 ⟨w, h10⟩).2 h))
      · obtain rfl : w = 10 := by omega
        rw [xs_ten, xs_ten, h12 0 (fun h => hwK (hK2.2 h))]
    · intro i hi hK u hu
      by_cases huK : u ∈ K
      · exact Or.inr (hBK u ((hcl' i hi u hu).2 hK huK) huK)
      · exact Or.inl huK
  unfold Circuit.eval
  by_cases ho : C.output ∈ K
  · exact hBK _ (hout ho) ho
  · exact outK _ ho


def A : List ℕ := [50, 69, 138, 276, 521, 385, 770, 548, 104, 208]

def tab : List ℕ := [1, 2, 4, 6, 9, 12, 9, 9, 5, 3, 2]

def Gk (z : Fin 10 → Bool) : Bool :=
  (List.finRange 10).any fun i => z i && (List.finRange 10).any fun j => z j && (A.getD i 0).testBit j

theorem Fz_eq (z : Fin 10 → Bool) :
    decide (∃ (x4 : Fin 10) (x5 : Fin 10), z x4 = true ∧ z x5 = true ∧ (A.getD ↑x4 0).testBit ↑x5 = true) = Gk z := by
  unfold Gk
  rw [Bool.eq_iff_iff, decide_eq_true_iff]
  simp [List.any_eq_true, List.mem_finRange]

def um (s a b : ℕ) : Fin 10 → Bool := fun i => if s.testBit i then a.testBit i else b.testBit i

def popc (s : ℕ) : ℕ := (Finset.univ.filter fun i : Fin 10 => s.testBit i).card

def vec (s a : ℕ) (ts : List ℕ) : List Bool := ts.map fun b => Gk (um s a b)

def checkOne (s : ℕ) (d : List ℕ × List ℕ) : Bool :=
  (d.1.length == tab.getD (popc s) 0) && decide ((d.1.map fun a => vec s a d.2).Nodup)

