theorem main : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x2 : Fin (10 : ℕ) → Bool), x1.eval (List.ofFn x2 ++ [!x2 (0 : Fin (10 : ℕ))]) = (fun (x3 : Fin (10 : ℕ) → Bool) => Decidable.decide (∃ (x4 : Fin (10 : ℕ)) (x5 : Fin (10 : ℕ)), x3 x4 = Bool.true ∧ x3 x5 = Bool.true ∧ ([(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)].getD ↑x4 (0 : ℕ)).testBit ↑x5 = Bool.true)) x2) → ∀ (x3 : Finset (Fin (10 : ℕ))) (x4 x5 : Finset ℕ), (∀ (x6 : Fin (10 : ℕ)), ↑x6 ∈ x4 ↔ x6 ∈ x3) → ((10 : ℕ) ∈ x4 ↔ (0 : Fin (10 : ℕ)) ∈ x3) → (∀ (x8 : Fin x1.size), ∀ x9 ∈ (x1.gates.get x8).inputs, ((11 : ℕ) + ↑x8 ∈ x4 → x9 ∈ x4) ∧ ((11 : ℕ) + ↑x8 ∉ x4 → x9 ∈ x4 → x9 ∈ x5)) → (x1.output ∈ x4 → x1.output ∈ x5) → [(1 : ℕ), (2 : ℕ), (4 : ℕ), (6 : ℕ), (9 : ℕ), (12 : ℕ), (9 : ℕ), (9 : ℕ), (5 : ℕ), (3 : ℕ), (2 : ℕ)].getD x3.card (0 : ℕ) ≤ (Finset.image (fun (x10 : Fin (10 : ℕ) → Bool) (x11 : ↥x5) => (x1.wires (List.ofFn x10 ++ [!x10 (0 : Fin (10 : ℕ))])).getD (↑x11) Bool.false) Finset.univ).card := by
  intro C hF S K B hK1 hK2 hcl hout
  have hF' : ∀ z, C.eval (xs z) = Gk z := fun z => (hF z).trans (Fz_eq z)
  set s0 := ∑ i ∈ S.image Fin.val, 2 ^ i with hs0def
  have hs0 : ∀ i : Fin 10, s0.testBit i = true ↔ i ∈ S := by
    intro i
    rw [← Nat.mem_bitIndices, ← List.mem_toFinset, hs0def, Finset.toFinset_bitIndices_sum_two_pow]
    simp only [Finset.mem_image]
    constructor
    · rintro ⟨a, ha, h⟩
      rwa [Fin.ext h] at ha
    · intro h
      exact ⟨i, h, rfl⟩
  set s := s0 % 1024 with hsdef
  have hs : ∀ i : Fin 10, s.testBit i = s0.testBit i := by
    intro i
    rw [hsdef, show (1024 : ℕ) = 2 ^ 10 by norm_num, Nat.testBit_mod_two_pow]
    simp [i.isLt]
  have hsS : ∀ i : Fin 10, s.testBit i = true ↔ i ∈ S := fun i => by rw [hs]; exact hs0 i
  have hslt : s < 1024 := Nat.mod_lt _ (by norm_num)
  have hS : S = Finset.univ.filter fun i : Fin 10 => s.testBit i := by
    ext i; simp [hsS]
  have hcard : S.card = popc s := by rw [hS]; rfl
  have hc := check_all s hslt
  set d := dat s
  unfold checkOne at hc
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hc
  obtain ⟨hlen, hnd⟩ := hc
  let Φ : (Fin 10 → Bool) → (↥B → Bool) := fun z w => (C.wires (List.ofFn z ++ [!z 0])).getD ↑w false
  let g : ℕ → (↥B → Bool) := fun a => Φ (um s a 0)
  have hinj : ∀ a ∈ d.1, ∀ a' ∈ d.1, g a = g a' → a = a' := by
    intro a ha a' ha' hg
    apply List.inj_on_of_nodup_map hnd ha ha'
    unfold vec
    apply List.map_congr_left
    intro b _
    rw [← hF', ← hF']
    apply key C S K B hK1 hK2 hcl hout (um s a 0) (um s a' 0)
    · intro w hw
      exact congrFun hg ⟨w, hw⟩
    · intro i hi
      simp [um, (hsS i).2 hi]
    · intro i hi
      simp [um, (hsS i).2 hi]
    · intro i hi
      have : s.testBit i = false := by
        by_contra h
        exact hi ((hsS i).1 (by simpa using h))
      simp [um, this]
  have hnd2 : (d.1.map g).Nodup := List.Nodup.map_on hinj (List.Nodup.of_map _ hnd)
  have hsub : (d.1.map g).toFinset ⊆ Finset.image Φ Finset.univ := by
